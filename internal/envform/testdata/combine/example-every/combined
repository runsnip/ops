# Example App — the settings this stack reads.
#
# Copy to .env and fill it in. Never commit .env.

# ---- image -------------------------------------------------------------------
# Lower-case registry account.
REGISTRY=registry.example.net/team/example-app
# 'latest' is the newest; pin a version (1.2.3) to stay on it.
WEB_TAG=1.3.0
API_TAG=2.0.0

# ---- domains -----------------------------------------------------------------
# The app's own hostname.
APP_HOST=app.example.com
# Optional: a second hostname for previews.
PREVIEW_HOST=preview.example.com

# ---- database ----------------------------------------------------------------
DB_USER=
DB_PASSWORD=pa=ss
DB_NAME=

# ---- secrets -----------------------------------------------------------------
# openssl rand -hex 32
SESSION_SECRET=abc
# A quoted value with spaces and a hash inside.
GREETING='single quoted'
SINGLE=

# ---- knobs -------------------------------------------------------------------
# Prose, not variables — two or more spaces after the #:
#   LOG_FORMAT=PRETTY   LOG_COLOR=ansi
#  INDENTED=prose
# LOG_LEVEL=debug
LOG_COLOR=ansi
# MAIL_PORT=587          # 465 with TLS
# MAIL_HOST=smtp.example.net

# ---- duplicated on purpose -----------------------------------------------------
WORKERS=
WORKERS=4
# FEATURE_X=on
FEATURE_X=

# ---- only in the old .env, the example does not name them -------------------
# Kept so nothing is lost. Still used? If not, delete them.
ONLY_IN_ENV=1
# OLD_SWITCH=yes
ANOTHER_OLD='a b' # kept
